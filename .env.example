# Stripe checkout. Use a Stripe account for FreakyTimes only (not the Blazed Kitty one), so orders and Track Order stay separate.
# Leave empty and the bag shows "checkout not connected yet".
STRIPE_SECRET_KEY=

# Resend newsletter sign-ups (Freaky Club). Both are needed.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Stripe webhook signing secret (whsec_...). Stripe Dashboard > Developers > Webhooks >
# add endpoint https://freakytimes.com/api/stripe-webhook with events
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# Printful private token for the FreakyTimes store. Paid orders are sent here by the webhook.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=

# true (default) = Printful starts printing right away and bills your Printful card.
# false = orders land in Printful as drafts for you to check and confirm by hand.
PRINTFUL_CONFIRM_ORDERS=true

# CJ Dropshipping API key (My CJ > Authorization > API). Paid CJ items are ordered with it.
CJ_API_KEY=
# true (default) = pay CJ orders from your CJ wallet right away. If the wallet is short,
# the order is still created, unpaid, so you can pay it in the CJ dashboard.
# false = always create CJ orders unpaid.
CJ_AUTO_PAY=true
# cheapest (default) or fastest CJ shipping method.
CJ_SHIPPING=cheapest

# AliExpress dropshipping app (openservice.aliexpress.com > App Console).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# true (default) = pay AliExpress orders right away with the payment method on the AliExpress account.
ALIEXPRESS_AUTO_PAY=true
# cheapest (default) or fastest AliExpress shipping.
ALIEXPRESS_SHIPPING=cheapest

# Long random password for admin-only routes (AliExpress sign-in and catalog tools).
# Make one with: openssl rand -hex 24
ADMIN_TOKEN=

# Public site URL, used for Stripe success and cancel links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
